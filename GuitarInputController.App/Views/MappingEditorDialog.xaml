<Window
    x:Class="GuitarInputController.App.Views.MappingEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:GuitarInputController.App.ViewModels"
    Title="{Binding WindowTitle}"
    Width="420"
    Height="420"
    WindowStyle="None"
    AllowsTransparency="True"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Background="Transparent">

    <Border
        Background="{StaticResource BackgroundBrush}"
        BorderBrush="#D0D0D0"
        BorderThickness="1"
        CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ────── TITLE BAR ────── -->
            <Border
                Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                CornerRadius="6,6,0,0"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock
                        Text="{Binding WindowTitle}"
                        Foreground="#FFFFFF"
                        FontSize="13"
                        FontWeight="SemiBold"
                        FontFamily="Microsoft YaHei UI"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0" />
                    <Button
                        Content="&#xE8BB;"
                        Width="36"
                        Height="28"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        ToolTip="关闭" />
                </Grid>
            </Border>

            <!-- ────── FORM CONTENT ────── -->
            <StackPanel Grid.Row="1" Margin="20,16">

                <!-- Note selector -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="音符"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}" />
                    <ComboBox
                        Grid.Column="1"
                        Width="200"
                        ItemsSource="{x:Static vm:MappingEditorViewModel.AvailableNotes}"
                        SelectedItem="{Binding Note}"
                        Style="{StaticResource FlatComboBoxStyle}" />
                </Grid>

                <!-- Action type -->
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="动作类型"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}" />
                    <ComboBox
                        Grid.Column="1"
                        Width="200"
                        ItemsSource="{x:Static vm:MappingEditorViewModel.ActionTypeNames}"
                        SelectedIndex="{Binding ActionTypeIndex}"
                        Style="{StaticResource FlatComboBoxStyle}" />
                </Grid>

                <!-- Key code (visible for KeyPress and Combination) -->
                <Grid
                    Margin="0,8"
                    Visibility="{Binding IsKeyCodeVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="目标按键"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}" />
                    <ComboBox
                        Grid.Column="1"
                        Width="200"
                        ItemsSource="{x:Static vm:MappingEditorViewModel.AvailableKeys}"
                        SelectedItem="{Binding KeyCode}"
                        Style="{StaticResource FlatComboBoxStyle}" />
                </Grid>

                <!-- Modifier keys (visible only for Combination) -->
                <Border
                    Margin="0,8"
                    Visibility="{Binding IsModifierVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock
                            Text="修饰键"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Margin="0,0,0,4" />
                        <ItemsControl
                            ItemsSource="{x:Static vm:MappingEditorViewModel.AvailableModifiers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Content="{Binding}"
                                        Style="{StaticResource FlatCheckBoxStyle}"
                                        Margin="0,0,16,4"
                                        Checked="ModifierCheckBox_Changed"
                                        Unchecked="ModifierCheckBox_Changed" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Mouse button (visible only for MouseClick) -->
                <Grid
                    Margin="0,8"
                    Visibility="{Binding IsMouseVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="鼠标按键"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}" />
                    <ComboBox
                        Grid.Column="1"
                        Width="200"
                        ItemsSource="{x:Static vm:MappingEditorViewModel.MouseButtonNames}"
                        SelectedIndex="{Binding MouseButtonIndex}"
                        Style="{StaticResource FlatComboBoxStyle}" />
                </Grid>

                <!-- Trigger mode -->
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="触发模式"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}" />
                    <ComboBox
                        Grid.Column="1"
                        Width="200"
                        ItemsSource="{x:Static vm:MappingEditorViewModel.TriggerModeNames}"
                        SelectedIndex="{Binding TriggerModeIndex}"
                        Style="{StaticResource FlatComboBoxStyle}" />
                </Grid>

                <!-- Label -->
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="标签"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBox
                        Grid.Column="1"
                        Width="200"
                        Text="{Binding Label, TargetNullValue=''}"
                        Style="{StaticResource FlatTextBoxStyle}" />
                </Grid>

            </StackPanel>

            <!-- ────── BOTTOM BUTTONS ────── -->
            <Border
                Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="0,0,6,6"
                Padding="16,10">
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
                    <Button
                        Content="取消"
                        Width="70"
                        Height="30"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <Button
                        Content="保存"
                        Width="70"
                        Height="30"
                        Margin="8,0,0,0"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
