<UserControl x:Class="GuitarInputController.UI.Controls.AudioLevelMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="20" Width="200">
    <Grid>
        <ProgressBar x:Name="LevelBar"
                     Minimum="0" Maximum="1"
                     Value="0"
                     Foreground="#00AAFF"
                     Background="#333333"
                     BorderThickness="0"
                     Height="8" />
    </Grid>
</UserControl>
